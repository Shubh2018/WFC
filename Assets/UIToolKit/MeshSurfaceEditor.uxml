<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="VisualElement" data-source="" style="flex-grow: 1;">
        <ui:Button text="Spawn Objects" name="_spawnObjectsButton"/>
        <ui:IntegerField label="Spawn Hierarchy" value="5" name="_spawnHierarchy" data-source-type="MeshSurface, Assembly-CSharp" data-source-path="_spawnHierarchy" binding-path="_spawnHierarchy"/>
        <ui:Vector3Field label="Surface Size" name="_surfaceSize" data-source-type="MeshSurface, Assembly-CSharp" data-source-path="_surfaceSize" binding-path="_surfaceSize" value="1,1,1"/>
        <ui:Toggle label="Choose Objects" name="_spawnToggle" data-source-type="MeshSurface, Assembly-CSharp" data-source-path="_spawnViaSpawner" value="false" binding-path="_spawnViaSpawner"/>
        <ui:EnumField label="Spawn Type" value="Small" type="PropSpawnTagEnum, Assembly-CSharp" name="_spawnTypeField" enabled="true" data-source-type="MeshSurface, Assembly-CSharp" data-source-path="_spawnTypeTag" binding-path="_spawnTypeTag"/>
        <uie:PropertyField name="_objectsToSpawn" binding-path="_gameObjectsToSpawn" data-source-path="_gameObjectsToSpawn" label="Game Objects To Spawn" tabindex="3" data-source-type="MeshSurface, Assembly-CSharp" enabled="true" style="display: none;"/>
    </ui:VisualElement>
</ui:UXML>
