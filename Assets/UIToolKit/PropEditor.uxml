<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
        <ui:GroupBox name="_overviewGroup" text="Overview" focusable="false" enabled="true" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); padding-right: 5px; padding-left: 5px; align-items: stretch; margin-top: 6px;">
            <uie:ObjectField label="Prop" data-source-type="Prop, Assembly-CSharp" data-source-path="_prop" binding-path="_prop" name="_propObjectField"/>
            <ui:FloatField label="Spawn Chance" value="0.5" name="_spawnChanceField" data-source-type="Prop, Assembly-CSharp" data-source-path="_spawnChance" binding-path="_spawnChance" max-length="3" mask-character="0"/>
        </ui:GroupBox>
        <ui:GroupBox name="_settingsGroup" text="Details" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); padding-right: 5px; padding-left: 5px;">
            <ui:EnumField label="Placement" value="Floor" type="PropPlacementType, Assembly-CSharp" name="_placementEnumField" data-source-type="Prop, Assembly-CSharp" data-source-path="_propPlacement" binding-path="_propPlacement"/>
            <ui:EnumField label="Size" value="Small" type="PropSpawnTagEnum, Assembly-CSharp" name="_tagEnumField" data-source-type="Prop, Assembly-CSharp" data-source-path="_spawnTag" binding-path="_spawnTag"/>
            <ui:ListView name="_keywordsListView" data-source-type="Prop, Assembly-CSharp" data-source-path="_keywords" binding-path="_keywords" show-border="true" show-add-remove-footer="true" show-foldout-header="true" horizontal-scrolling="false" reorderable="false" header-title="Keywords" style="margin-left: 15px;"/>
        </ui:GroupBox>
        <ui:GroupBox name="_limitGroup" text="Hierarchy" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); padding-right: 5px; padding-left: 5px;">
            <ui:EnumField label="Limit" value="PerRoom" type="PropLimitTypeEnum, Assembly-CSharp" name="_limitEnumField" data-source-type="Prop, Assembly-CSharp" data-source-path="_limitType" binding-path="_limitType"/>
            <ui:IntegerField label="Minimum" value="1" name="_lowerLimitCountField" data-source-type="Prop, Assembly-CSharp" data-source-path="_lowerLimitCount" binding-path="_lowerLimitCount" max-length="25"/>
            <ui:IntegerField label="Maximum" value="5" name="_higherLimitCountField" data-source-type="Prop, Assembly-CSharp" data-source-path="_higherLimitCount" binding-path="_higherLimitCount" max-length="50"/>
        </ui:GroupBox>
        <ui:GroupBox name="_spawningGroup" text="Spawning" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); padding-right: 5px; padding-left: 5px;">
            <ui:GroupBox name="_spawningPositionGroup" text="Position" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); padding-right: 5px; padding-left: 5px;">
                <ui:EnumField label="Specified Area" value="Random" type="SpawnPosition, Assembly-CSharp" name="_positionEnumField" data-source-type="Prop, Assembly-CSharp" data-source-path="_spawnPositions" binding-path="_spawnPositions"/>
                <ui:Toggle label="Use Static Position" name="_staticToggle" data-source-type="Prop, Assembly-CSharp" data-source-path="_useStaticPositions" binding-path="_useStaticPositions"/>
                <ui:Toggle label="Against Walls Only" name="_spawnInCornersToggle" data-source-type="Prop, Assembly-CSharp" data-source-path="_spawnInCorners" binding-path="_spawnInCorners"/>
            </ui:GroupBox>
            <ui:GroupBox name="_typeGroup" text="Type" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); padding-right: 5px; padding-left: 5px;">
                <ui:EnumField label="Prop" value="Decoration" type="PropType, Assembly-CSharp" name="_typeEnumField" data-source-type="Prop, Assembly-CSharp" data-source-path="_propType" binding-path="_propType"/>
                <uie:PropertyField name="_environmentTypeField" data-source-type="Prop, Assembly-CSharp" data-source-path="_environmentType" binding-path="_environmentType" label="Environment" enabled="false"/>
                <uie:EnumFlagsField label="Node" value="DynamicTransform" type="Node+NodeType, Assembly-CSharp" name="_nodeTypeEnumField" data-source-type="Prop, Assembly-CSharp" data-source-path="_nodeType" binding-path="_nodeType" enabled="false"/>
                <ui:Toggle label="Use Spacing" name="_spacingEnabledToggle" data-source-type="Prop, Assembly-CSharp" data-source-path="_spacingEnabled" binding-path="_spacingEnabled" enabled="false"/>
                <ui:FloatField label="Spacing Amount" value="1" name="_spacingAmountField" data-source-type="Prop, Assembly-CSharp" data-source-path="_spacingAmount" binding-path="_spacingAmount" max-length="3" enabled="false"/>
            </ui:GroupBox>
            <ui:GroupBox name="_spawningRotationGroup" text="Rotation" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); padding-right: 5px; padding-left: 5px;">
                <ui:EnumField label="Type" value="Random" type="PropRotationTypeEnum, Assembly-CSharp" name="_rotationEnumField" data-source-type="Prop, Assembly-CSharp" data-source-path="_spawnRotationType" binding-path="_spawnRotationType"/>
                <ui:FloatField label="Amount" value="0" name="_rotationAmountField" enabled="false" max-length="360" data-source-type="Prop, Assembly-CSharp" data-source-path="_spawnRotation" binding-path="_spawnRotation"/>
            </ui:GroupBox>
            <ui:GroupBox name="_relationshipsGroup" text="Relationships" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(29, 29, 29); border-right-color: rgb(29, 29, 29); border-top-color: rgb(29, 29, 29); border-bottom-color: rgb(29, 29, 29); padding-right: 5px; padding-left: 5px;">
                <ui:IntegerField label="Max Neighbors" value="1" name="_neighborCount" data-source-type="Prop, Assembly-CSharp" data-source-path="_neighborCount" binding-path="_neighborcount" max-length="3"/>
                <ui:ListView name="_neighborsListView" data-source-type="Prop, Assembly-CSharp" data-source-path="_neighbors" binding-path="_neighbors" header-title="Neighbors" show-border="true" show-add-remove-footer="true" allow-add="true" allow-remove="true" show-bound-collection-size="true" virtualization-method="DynamicHeight" show-foldout-header="true" picking-mode="Ignore" binding-source-selection-mode="Manual" horizontal-scrolling="false" reorderable="false" style="margin-left: 15px;"/>
            </ui:GroupBox>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
